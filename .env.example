# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
PUBLIC_BASE_URL=http://localhost:3001

# ─── Database (Postgres — Supabase or Neon) ──────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/smm?schema=public

# ─── Redis / BullMQ ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Twilio SMS (the product's channel) ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ─── LLM (Anthropic — Haiku 4.5 bulk, Sonnet 5 voice/planning) ───────────
ANTHROPIC_API_KEY=
LLM_MODEL_BULK=claude-haiku-4-5
LLM_MODEL_VOICE=claude-sonnet-5

# ─── Image generation ────────────────────────────────────────────────────
# OpenAI GPT Image is the default (chosen after a 4-model head-to-head).
# Set OPENAI_API_KEY to turn generated photos on. FAL/FLUX stays wired as a
# fallback — set FAL_API_KEY instead and it's used automatically if no OpenAI
# key is present. OPENAI_IMAGE_MODEL overrides the model id if it changes.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
FAL_API_KEY=
REPLICATE_API_TOKEN=

# ─── Publishing (Post for Me — unified posting API) ──────────────────────
POST_FOR_ME_API_KEY=
POST_FOR_ME_BASE_URL=https://api.postforme.dev

# ─── Google Business Profile (direct — Post for Me has no Google support) ──
# Create an OAuth 2.0 Web client in the Google Cloud project (handled-gbp) once
# the Business Profile API access request is approved, then paste the client id
# and secret here. The redirect URI must be registered on that OAuth client and
# defaults to PUBLIC_SITE_URL + /connect/google/callback. Until these are set,
# Google Business Profile connect and publishing stay inert (offline demo).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=   # override only if not PUBLIC_SITE_URL/connect/google/callback

# ─── Storage (Cloudflare R2) ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=smm-media
R2_PUBLIC_BASE_URL=

# ─── Token encryption at rest (§8) — 32-byte key, base64 ─────────────────
TOKEN_ENCRYPTION_KEY=

# ─── Payments (Stripe) ───────────────────────────────────────────────────
# Set the secret key + the three Price IDs to make the /billing buttons live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
# Where Stripe sends the customer back after checkout (your marketing site).
PUBLIC_SITE_URL=https://aissm-web.vercel.app

# ─── Web app (apps/web) ──────────────────────────────────────────────────
# Point the marketing site at your deployed backend to make checkout live.
NEXT_PUBLIC_API_URL=
# Shows the email sign-up form on /start. Leave unset until Postmark sending and
# the inbound webhook both work; the backend also refuses sign-ups until then.
NEXT_PUBLIC_EMAIL_SIGNUP=

# ─── Observability ───────────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_KEY=

# ─── Media storage (Cloudflare R2) ───────────────────────────────────────
# All four upload values are needed; without them media stays on local disk
# (MEDIA_DIR) and Post for Me can't fetch it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ─── Email channel (Postmark) ────────────────────────────────────────────
# Email sign-ups open only when POSTMARK_SERVER_TOKEN and EMAIL_INBOUND_SECRET
# are both set.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=
EMAIL_INBOUND_ADDRESS=
EMAIL_INBOUND_SECRET=

# ─── Operations ──────────────────────────────────────────────────────────
# Bearer token for /admin. Required to open the admin pages.
ADMIN_TOKEN=
# A phone that gets a text when a new lead uses their free draft.
LEAD_ALERT_PHONE=
# Free drafts per day across all unpaid numbers (default 25).
FREE_DRAFTS_PER_DAY=
# 0 turns the weekly plan / publish / metrics crons off (local dev, tests).
ENABLE_CRON=
# "instagram" switches Instagram linking from Facebook Login to Instagram Login.
PFM_INSTAGRAM_CONNECTION=
